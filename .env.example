# ===== 服务端口 =====
PORT=3000

# ===== JWT 密钥（生产环境请修改为随机长字符串）=====
JWT_SECRET=change-me-to-a-long-random-string

# ===== GLM 大模型（智谱 AI）API 配置 =====
# 申请地址：https://open.bigmodel.cn/
GLM_API_KEY=
# 兼容 OpenAI 格式的对话补全端点
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 模型名称（GLM-5.2 / glm-4.5 / glm-4-plus 等，按账号可用模型填写）
GLM_MODEL=glm-4.5

# 未配置 GLM_API_KEY 时，系统自动使用内置的结构化演示引擎，功能可完整体验。
