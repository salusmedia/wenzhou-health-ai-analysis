# ===== 服务端口 =====
PORT=3000

# ===== JWT 密钥（生产环境请修改为随机长字符串）=====
JWT_SECRET=change-me-to-a-long-random-string

# ===== GLM 大模型（智谱 AI）API 配置 =====
# 申请地址：https://open.bigmodel.cn/
GLM_API_KEY=
# 兼容 OpenAI 格式的对话补全端点
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 模型名称（默认 GLM-5.2；私有化/专属实例见需求开发书 4.1，原始病历建议走私有实例）
GLM_MODEL=glm-5.2

# 未配置 GLM_API_KEY 时，系统自动使用内置的结构化演示引擎，功能可完整体验。
